{
  // Content Factory Dashboard on Cloudflare. Stage 2: the job queue AI-DESKTOP pulls render jobs from.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "content-factory-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-factory",
      "database_id": "d63e426a-5c43-4deb-b858-4d665ca173f7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "content-factory-media" }]
  // Secrets (set with `wrangler secret put` or in the Cloudflare dashboard, never in git):
  //   WORKER_TOKEN   the token AI-DESKTOP uses to pick up jobs
  //   SUBMIT_TOKENS  JSON {"<token>": "beegraphix" | "rugbee" | "*"}: who may submit and see jobs, per brand
}
